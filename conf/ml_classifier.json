{
  "description": "船舶故障分类器：用告警变量名 + 异常分数预测故障类型，优化 F1",
  "source": {
    "index": ["ship-events*"],
    "query": { "match_all": {} }
  },
  "dest": {
    "index": "ship-fault-classified"
  },
  "analysis": {
    "classification": {
      "dependent_variable": "alarm_name",
      "training_percent": 80,
      "num_top_classes": 20,
      "num_top_feature_importance_values": 10
    }
  },
  "analyzed_fields": {
    "includes": [],
    "excludes": ["acknowledged"]
  },
  "model_memory_limit": "200mb"
}
