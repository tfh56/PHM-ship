{
  "policy": {
    "phases": {
      "hot": {
        "actions": {
          "rollover": { "max_age": "30d", "max_primary_shard_size": "50gb" },
          "set_priority": { "priority": 100 }
        }
      },
      "warm": {
        "min_age": "__HOT__m",
        "actions": {
          "shrink": { "number_of_shards": 1 },
          "forcemerge": { "max_num_segments": 1 },
          "set_priority": { "priority": 50 }
        }
      },
      "cold": {
        "min_age": "__WARM__m",
        "actions": {
          "freeze": {},
          "set_priority": { "priority": 0 }
        }
      },
      "frozen": {
        "min_age": "__COLD__m",
        "actions": {
          "searchable_snapshot": { "snapshot_repository": "ship-snap-repo" }
        }
      },
      "delete": {
        "min_age": "60m",
        "actions": { "delete": {} }
      }
    }
  }
}
