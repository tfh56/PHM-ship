{
  "index_patterns": ["ship-engine-metrics*"],
  "data_stream": {},
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "ship-lifecycle"
    },
    "mappings": {
      "properties": {
        "@timestamp":   { "type": "date" },
        "name":         { "type": "keyword" },
        "value":        { "type": "double" },
        "timestamp":    { "type": "date", "format": "epoch_second" },
        "ship_id":      { "type": "keyword" },
        "engine_id":    { "type": "keyword" },
        "is_alarm":     { "type": "boolean" },
        "alarm_name":   { "type": "keyword" }
      }
    }
  }
}
