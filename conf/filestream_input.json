{
  "package_policy_id": "ship-filestream-1",
  "policy_id": "ship-filestream-policy",
  "package": { "name": "log", "version": "2.0.0" },
  "name": "ship-filestream",
  "namespace": "ship",
  "inputs": {
    "logs-logs.filestream": {
      "streams": {
        "engine.log": {
          "vars": {
            "paths": ["__ENGINE_DIR__/*.txt"],
            "data_stream.dataset": "engine",
            "parsers": [
              { "ndjson": { "target": "json" } }
            ]
          }
        },
        "imu.log": {
          "vars": {
            "paths": ["__IMU_DIR__/*.txt"],
            "data_stream.dataset": "imu",
            "parsers": [
              { "ndjson": { "target": "json" } }
            ]
          }
        }
      }
    }
  }
}
