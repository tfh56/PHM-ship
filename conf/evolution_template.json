{
  "index_patterns": ["ship-evolution*"],
  "data_stream": {},
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp":   { "type": "date" },
        "role":         { "type": "keyword" },
        "identity":     { "type": "text" },
        "skills":       { "type": "keyword" },
        "event":        { "type": "keyword" },
        "detail":       { "type": "text" }
      }
    }
  }
}
